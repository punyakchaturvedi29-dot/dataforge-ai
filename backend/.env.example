# ─────────────────────────────────────────────────────────────────────────────
# DataForge AI — backend configuration
#
#   cp .env.example .env      (Windows: copy .env.example .env)
#
# Every setting is optional. Values shown are the defaults. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Optional AI features ─────────────────────────────────────────────────────
# The copilot, summaries and reports work fully offline from computed results.
# With a key, an LLM can additionally route free-form questions and phrase
# explanations; its numbers are checked against the computed results.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# LLM_ENABLED=true
# LLM_TIMEOUT_S=30

# ── Storage & retention ──────────────────────────────────────────────────────
# DATAFORGE_DATA_DIR=./data          # workspaces, datasets (parquet), models
# WORKSPACE_TTL_DAYS=14              # idle workspaces are deleted after this
# WORKSPACE_LISTING=true             # false = workspaces only reachable by link

# ── Security ─────────────────────────────────────────────────────────────────
# Signs saved model files (HMAC-SHA256). If unset, a random key is generated
# once in DATAFORGE_DATA_DIR/.secret_key (mode 600). Set it explicitly when
# several server processes share one data directory.
# DATAFORGE_SECRET_KEY=
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CSV_FORMULA_ESCAPE=true            # neutralise =,+,-,@ cells in CSV exports

# ── Limits ───────────────────────────────────────────────────────────────────
# MAX_UPLOAD_MB=100
# MAX_ROWS=2000000
# MAX_COLUMNS=1000
# MAX_CELLS=60000000
# MAX_JSON_BODY_KB=2048
# TRAINING_MAX_ROWS=200000           # larger datasets are sampled for AutoML
# TRAINING_TIME_BUDGET_S=120
# MAX_CONCURRENT_JOBS=2
# ML_N_JOBS=2
# BATCH_PREDICT_MAX_ROWS=500000

# ── Misc ─────────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# FRONTEND_DIST=../frontend/dist     # served at / when present (single-process mode)
